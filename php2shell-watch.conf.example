# Slack incoming webhook (empty = log to /var/log/php2shell-watch.log and syslog only)
SLACK_WEBHOOK=""
# Mail address, sent through the local sendmail (empty = off)
MAIL_TO=""
# Regex of allowed child processes of php-fpm, e.g. 'convert|jpegoptim|cwebp'
IGNORE_CHILDREN=""
# Regex of paths the new-file check may ignore
IGNORE_PATHS=""
# PHP-FPM log files to scan for crashed workers (globs allowed). Empty = autodetect:
# /var/log/php*-fpm.log (Debian/Ubuntu), /var/log/php-fpm/*.log (RHEL/Amazon Linux), Remi SCL
FPM_LOGS=""
# Directories that hold the web roots. Empty = /home /var/www /srv (those that exist)
WEB_ROOTS=""

# Listening processes to ignore in the "site user listening on a port" check (regex on the
# full command line). Default: Laravel Nightwatch agent, which listens on 127.0.0.1 under supervisord.
#IGNORE_LISTEN="nightwatch:agent|reverb:start"
# Shells a site user starts detached from PHP on purpose (Matomo's marketplace cache warmer is ignored by default)
#IGNORE_SHELLS="marketplace:warm-cache|my-queue:work"
